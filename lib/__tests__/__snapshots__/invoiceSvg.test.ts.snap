  <text x="400" y="248" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="500" fill="#f4f4f5" text-anchor="middle">TechBridge Solutions Ltd</text>

  <!-- Discount Rate / Risk Tier -->
  <text x="752" y="228" font-family="system-ui, -apple-system, sans-serif" font-size="10" fill="#71717a" letter-spacing="1" text-anchor="end">DISCOUNT RATE</text>
  <text x="752" y="248" font-family="system-ui, -apple-system, sans-serif" font-size="15" font-weight="600" fill="#22c55e" text-anchor="end">6.0%</text>

  <!-- Divider -->
  <line x1="32" y1="272" x2="768" y2="272" stroke="#27272a" stroke-width="1" />

  <!-- Tags row -->
  
    <rect x="48" y="292" width="35" height="24" rx="6" fill="#18181b" stroke="#a1a1aa" stroke-width="0.5" stroke-opacity="0.4" />
    <text x="65.5" y="307" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" fill="#a1a1aa" text-anchor="middle" letter-spacing="0.3">KE</text>
    <rect x="91" y="292" width="95" height="24" rx="6" fill="#18181b" stroke="#a1a1aa" stroke-width="0.5" stroke-opacity="0.4" />
    <text x="138.5" y="307" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" fill="#a1a1aa" text-anchor="middle" letter-spacing="0.3">Technology</text>
    <rect x="194" y="292" width="65" height="24" rx="6" fill="#22d3ee18" stroke="#22d3ee" stroke-width="0.5" stroke-opacity="0.4" />
    <text x="226.5" y="307" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="600" fill="#22d3ee" text-anchor="middle" letter-spacing="0.3">Tier A</text>

  <!-- IPFS document CID (bottom) -->
  <rect x="32" y="528" width="736" height="36" rx="8" fill="#18181b" opacity="0.6" />
  <text x="52" y="550" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#71717a" letter-spacing="0.5">IPFS DOCUMENT</text>
  <text x="52" y="562" font-family="ui-monospace, monospace" font-size="10" fill="#38bdf8">QmXoypiz…Wo6uco</text>

  <!-- Bottom border accent -->
  <rect x="0" y="596" width="800" height="4" fill="url(#kg-INV20240001-accent)" rx="2" />
</svg>"
`;

